#Leetcode Question - 183
SELECT name AS Customers FROM Customers WHERE id NOT IN ( SELECT customerId FROM Orders);


#Leetcode Question - 577
SELECT e.name, b.bonus FROM Employee e LEFT JOIN Bonus b ON e.empId = b.empId
WHERE b.bonus < 1000 OR b.bonus IS NULL;

#Leetcode Question - 1050
select actor_id, director_id from ActorDirector group by director_id, actor_id having count(director_id) >= 3;

#Leetcode Question - 595
SELECT name, population, area FROM World WHERE area >= 300000 OR population >= 25000000;

#Leetcode Question - 196
DELETE p1 FROM Person p1 JOIN Person p2 ON p1.email = p2.email AND p1.id > p2.id;

#Leetcode Question - 176
SELECT MAX(salary) AS SecondHighestSalary FROM Employee WHERE salary < ( SELECT MAX(salary) FROM Employee );

#Leetcode Question - 511
SELECT player_id, MIN(event_date) AS first_login FROM Activity GROUP BY player_id;

#Leetcode Question - 584
SELECT name FROM Customer WHERE referee_id <> 2 OR referee_id IS NULL;

#Leetcode Question - 596
SELECT class FROM Courses GROUP BY class HAVING COUNT(student) >= 5;
