#Leetcode Question - 2390

char* removeStars(char* s) {
    int n = strlen(s);
    char *stack = (char*)malloc(sizeof(char)*(n+1));
    int top = -1;
    for (int i=0; i<n; i++){
        if (s[i]!='*'){
            stack[++top]=s[i];
        }
        else{
            if (top>=0)
                top--;
        }
    }
    stack[++top]='\0';
    return stack;
}
